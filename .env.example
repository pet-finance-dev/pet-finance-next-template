# Example environment variables for local development and documentation.
# Copy this file to `.env.local` (or set the variables in your hosting provider) and update values.

# Base API URL used by the axios instance and API helpers
# e.g. http://localhost:8000 or https://api.example.com
NEXT_PUBLIC_BASE_API_URL=https://api.example.com

# Optional: Frontend base URL (if you need it in client code). Not required by the template but commonly useful.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Example feature flags / optional values
# NEXT_PUBLIC_ENABLE_SOME_FEATURE=false

# Notes:
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser by Next.js.
# - For secrets (server-only values), do NOT prefix with NEXT_PUBLIC_. Use runtime environment variables on the server or a secrets manager.
# - When running locally, copy this file to `.env.local` to override values for your environment.
